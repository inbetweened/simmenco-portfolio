# Copy to .env.local and fill in. Same values go into Vercel project settings.
# Project ID: shown at sanity.io/manage after creating the project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-01

# Shared secret for the publish webhook (any long random string).
# Must match the secret configured at sanity.io/manage -> API -> Webhooks.
SANITY_REVALIDATE_SECRET=
